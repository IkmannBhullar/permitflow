# Copy to .env.local and fill in. Never commit real secrets.
# Local values: run `pnpm supabase status -o env` after `pnpm db:start`.

# --- Public (shipped to the browser) ---------------------------------------
# Supabase API URL. Local: http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of this app, used to build invite links. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ----------------------------
# Supabase service-role / secret key. Bypasses RLS. Used ONLY by the seed script
# and the cron route.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/cron/due-notifications (min 16 chars).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Demo ---------------------------------------------------------------------
# The "Try the demo" button signs in as this project-manager account, which
# `pnpm db:seed` creates. Pick your own password for production.
DEMO_USER_EMAIL=pm@cascade-ridge.example
DEMO_USER_PASSWORD=
